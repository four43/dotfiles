Include config-remote-dev

Include ~/projects/VaisalaCorp/lightning-config/provisioning/ssh_config

# Home Network

Host home
    Hostname home.four43.com
    User smiller
    Port 289

Host orion
    Hostname orion.four43.com
    User smiller
    Port 289
    ForwardAgent yes

Host ursa-minor
    Hostname ursa-minor.four43.com
    User smiller
    Port 289
    ForwardAgent yes

Host tkmiller-net
    Hostname tkmiller-home.four43.com
    User smiller
    Port 289

# Vaisala Xweather

Host geotiff
    Hostname ec2-35-168-223-12.compute-1.amazonaws.com
    User core
    IdentityFile ~/.ssh/aerisweather/amp-import.pem

Host geotiff-staging
    Hostname ec2-34-238-87-43.compute-1.amazonaws.com
    User core
    IdentityFile ~/.ssh/aerisweather/amp-import.pem

Host geotiff-dev
    Hostname ec2-34-235-172-46.compute-1.amazonaws.com
    User core
    IdentityFile ~/.ssh/aerisweather/amp-import.pem

Host aeris-obs-summary-importer
    Hostname 10.0.35.140
    User ec2-user
    IdentityFile ~/.ssh/aerisweather/aeris-forecast.pem

Host lightning-lou-net-sshlp1
    User sethm
    IdentityFile ~/.ssh/id_rsa_vaisala

Host lightning-dal-net-sshlp1
    User sethm
    IdentityFile ~/.ssh/id_rsa_vaisala

# Defaults

Host *
    User smiller
    # Automatically add keys to ssh-agent on first use
    AddKeysToAgent yes
